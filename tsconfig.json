{
  "include": ["src/ts/**/*"],
  "compilerOptions": {
    "module": "es2020",
    "target": "es6",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "declarationDir": "build/types",
    "baseUrl": ".",
    "types": ["three"],
    "lib": ["es2017", "dom", "dom.iterable"],
    "paths": {
      "~/*": ["./src/ts/*"],
      "$lib/*": ["./src/lib/*"],
      "three/examples/jsm/*": ["./node_modules/three/examples/jsm/*"]
    }
  }
}
