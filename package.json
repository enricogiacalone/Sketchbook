  },
  "homepage": "https://github.com/swift502/Sketchbook",
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.10.0",
    "concurrently": "^8.2.0",
    "nodemon": "^2.0.22",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@types/three": "^0.181.0",
    "cannon-es": "^0.20.0",
