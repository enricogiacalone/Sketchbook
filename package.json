    "lil-gui": "^0.21.0",
    "lodash": "^4.17.21",
    "prettier": "^3.6.2",
    "simplex-noise": "^4.0.3",
    "socket.io": "^4.7.1",
    "socket.io-client": "^4.7.1",
    "stats.js": "^0.17.0",
    "sweetalert2": "^11.26.3",
